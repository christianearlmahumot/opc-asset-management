# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it.
# Rules: one KEY=value per line, no quotes, no spaces around "=".
# A key with an EMPTY value overrides the built-in default, so delete lines you do not need.

# --- Database (required) -------------------------------------------------------------------
# Supabase: Connect > Direct > Type JDBC > Session pooler. Keep only the part up to /postgres.
# Local Docker database (docker compose up -d): delete these three lines.
DB_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.your-project-ref
DB_PASSWORD=

# --- Security (required) -------------------------------------------------------------------
# At least 32 random characters. Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=

# Creates the first Administrator ("admin") ONLY when the database has no users yet. 8+ characters.
ADMIN_PASSWORD=

# --- File storage (optional locally, required on Render) -------------------------------------
# local = files under backend/uploads (default). supabase = private Supabase Storage bucket.
#STORAGE_TYPE=supabase
#SUPABASE_URL=https://your-project-ref.supabase.co
#SUPABASE_SERVICE_KEY=
#SUPABASE_BUCKET=fams-files

# --- Optional ------------------------------------------------------------------------------
#PROPERTY_CUSTODIAN_NAME=
#IO_FIRST_NUMBER=1804332
#CORS_ORIGINS=http://localhost:5173
